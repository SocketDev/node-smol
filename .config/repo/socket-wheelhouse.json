{
  "$schema": "./socket-wheelhouse-schema.json",
  "schemaVersion": 1,
  "repoName": "node-smol",
  "bundle": {
    "ref": "fleet-pack-045f3e759c7a43eae6d500a7f530985dfcd5e45c",
    "cascadeSha": "045f3e759c7a43eae6d500a7f530985dfcd5e45c"
  },
  "repo": {
    "type": "mono"
  },
  "build": {
    "from": "github-release",
    "type": "binary"
  },
  "docker": {
    "prebakes": {
      "registry": "ghcr.io/socketdev",
      "prebakes": [
        {
          "name": "node-smol/base",
          "status": "active",
          "from": "ghcr.io/socketdev/socket-wheelhouse/c-base:latest",
          "dockerfile": "docker/repo/node-smol-base.Dockerfile",
          "installs": ["python3.12 (V8 build)", "ccache config"],
          "libc": ["glibc", "musl"],
          "platforms": ["linux/amd64", "linux/arm64"],
          "tagFrom": "node-smol-toolchain-hash",
          "consumers": [
            "node-smol builder (+ COPY --from=ghcr.io/socketdev/socket-wheelhouse/node-base for the .mts driver)"
          ],
          "purpose": "The heavy Node.js/V8 compile environment, on top of the wheelhouse c-base. Split into its own layer for CACHE LOCALITY: the toolchain rarely changes, the Node source changes every version bump. The .mts driver's node comes via COPY --from=node-base, not a baked runtime."
        }
      ]
    }
  },
  "fuzz": {
    "exempt": true,
    "reason": "No first-party parser/decoder surface to fuzz yet: repo is fleet tooling plus vendored upstream/ native trees (stuie, decmpfs) that carry their own test tiers upstream. Revisit when node-smol grows first-party parsing code."
  },
  "submoduleRoots": {
    "grandfathered": [
      "packages/ai-infra/upstream/llama.cpp",
      "packages/bin-infra/upstream/zstd",
      "packages/binject/upstream/cJSON",
      "packages/binject/upstream/libdeflate",
      "packages/boringssl-builder/upstream/boringssl",
      "packages/curl-builder/upstream/curl",
      "packages/curl-builder/upstream/mbedtls",
      "packages/dawn-builder/upstream/dawn",
      "packages/libpq-builder/upstream/postgres",
      "packages/lief-builder/upstream/lief",
      "packages/lsquic-infra/upstream/ls-qpack",
      "packages/lsquic-infra/upstream/lsquic",
      "packages/node-smol-builder/test/fixtures/wpt/streams",
      "packages/node-smol-builder/upstream/libqrencode",
      "packages/node-smol-builder/upstream/liburing",
      "packages/node-smol-builder/upstream/md4c",
      "packages/node-smol-builder/upstream/node",
      "packages/node-smol-builder/upstream/semver",
      "packages/node-smol-builder/upstream/tree-sitter",
      "packages/node-smol-builder/upstream/uSockets",
      "packages/node-smol-builder/upstream/uWebSockets",
      "packages/onnxruntime-builder/upstream/onnxruntime",
      "packages/temporal-infra/test/fixtures/test262",
      "packages/temporal-infra/upstream/icu4x",
      "packages/temporal-infra/upstream/temporal",
      "packages/yoga-layout-builder/upstream/yoga"
    ]
  }
}
