	ref = 3641ed2c4cc4728308c498e88f766c0c19bf410d
	path = packages/node-smol-builder/test/fixtures/wpt/streams
	url = https://github.com/web-platform-tests/wpt.git
	ignore = dirty
	shallow = true
	# Honored by scripts/git-partial-submodule.mts (vanilla git ignores
	# this field). WPT is a ~5 GB tree; we only need the streams/ subtree
	# for WHATWG streams conformance tests.
	sparse-checkout = streams/
	verify = pnpm --filter node-smol-builder wpt:streams
